<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
  <!-- Include additional ABB-Resources/MATERIALS+COLOUR xacro files: -->
  <xacro:include filename="$(find ros2srrc_robots)/irb14000/urdf/abb_resources/common_materials.xacro"/>

  <!-- XACRO-MACRO of ABB-IRB120: -->
  <xacro:macro name="irb14000" params="bringup robot_ip EE EE_name">

    <!-- ABB-IRB120 TRANSMISSION: -->
    <xacro:unless value="${bringup}">  
      <xacro:include filename="$(find ros2srrc_robots)/irb14000/urdf/irb14000_transmission.xacro" />
      <xacro:irb14000_transmission />
    </xacro:unless>

    <!-- ABB-IRB120 GAZEBO - ROS2_CONTROL: -->
    <xacro:include filename="$(find ros2srrc_robots)/irb14000/urdf/irb14000_ros2control.xacro" />
    <xacro:irb14000_ros2control 
      bringup="${bringup}"
      robot_ip="${robot_ip}"
      EE="${EE}"
      EE_name="${EE_name}"
    />

    <!-- ***** ABB-IRB120 ROBOT .urdf SERIAL CHAIN ***** -->

    <!-- Link list: -->
    <!-- base_link -->
    <link name="base_link">
      <inertial>
        <mass value="6.215"/>
        <origin xyz="-0.04204 8.01E-05 0.07964" rpy="0 0 0"/>
        <inertia ixx="0.0247272" ixy="-8.0784E-05" ixz="0.00130902" iyy="0.0491285" iyz="-8.0419E-06" izz="0.0472376"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ros2srrc_robots)/irb120/meshes/visual/base_link.dae"/>
        </geometry>
        <xacro:material_abb_orange />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ros2srrc_robots)/irb120/meshes/collision/base_link.stl"/>
        </geometry>
        <xacro:material_abb_yellow />
      </collision>
    </link>

    <!-- link_1 -->
    <link name="link_1">
      <inertial>
        <mass value="1.2" />
