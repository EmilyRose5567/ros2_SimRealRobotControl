    <!-- end of link list -->

    <!-- Joint list: -->
    <!-- joint_1 -->
    <joint type="revolute" name="joint_1_r">
      <origin xyz="0.05355 -0.0725 0.41492" rpy="-0.9795   -0.5682   -2.3155"/>
      <axis xyz="0 0 1"/>
      <parent link="base_link"/>
      <child link="link_1_r"/>
      <limit effort="300" lower="-2.967" upper="2.967" velocity="3.14159"/>
      <dynamics damping="0.5" friction="1.0"/>
    </joint>

    <!-- joint_2 -->
    <joint type="revolute" name="joint_2_r">
      <origin xyz="0.03 0.0 0.1" rpy="1.57079632679 0.0 0.0"/>
      <axis xyz="0 0 1"/>
      <parent link="link_1_r"/>
      <child link="link_2_r"/>
      <limit effort="300" lower="-2.4" upper="0.7" velocity="3.14159"/>
      <dynamics damping="0.5" friction="1.0"/>
    </joint>

