<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
  <!-- Include additional ABB-Resources/MATERIALS+COLOUR xacro files: -->
  <xacro:include filename="$(find ros2srrc_robots)/irb14000/urdf/abb_resources/common_materials.xacro"/>

  <!-- XACRO-MACRO of ABB-IRB1200: -->
  <xacro:macro name="irb14000" params="bringup robot_ip EE EE_name">

    <!-- ABB-IRB1200 TRANSMISSION: -->
    <xacro:unless value="${bringup}">  
      <xacro:include filename="$(find ros2srrc_robots)/irb14000/urdf/irb14000_transmission.xacro" />
      <xacro:irb14000_transmission />
    </xacro:unless>

    <!-- ABB-IRB1200 GAZEBO - ROS2_CONTROL: -->
    <xacro:include filename="$(find ros2srrc_robots)/irb14000/urdf/irb14000_ros2control.xacro" />
    <xacro:irb14000_ros2control 
      bringup="${bringup}"
      robot_ip="${robot_ip}"
      EE="${EE}"
      EE_name="${EE_name}"
    />

    <!-- ***** ABB-IRB1200 ROBOT .urdf SERIAL CHAIN ***** -->

    <!-- Link list: -->
    <!-- base_link -->
    <link name="base_link">
      <inertial>
        <mass value="15"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="0.3"/>
      </inertial>
      <collision name="collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ros2srrc_robots)/irb14000/meshes/collision/base_link.stl"/>
        </geometry>
      </collision>
      <visual name="visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ros2srrc_robots)/irb14000/meshes/collision/base_link.stl"/>
        </geometry>
        <xacro:material_abb_yellow />
      </visual>
    </link>

    <!-- link_1 -->
    <link name="link_1_r">
      <inertial>
        <mass value="1.2"/>
        <origin xyz="0 -0.03 0.12"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
      <collision name="collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find ros2srrc_robots)/irb14000/meshes/collision/link_1.stl"/>
        </geometry>
      </collision>
      <visual name="visual">
