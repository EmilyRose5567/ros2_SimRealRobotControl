    <!-- ROS-Industrial 'base' frame- base_link to ABB World Coordinates transform -->
    <link name="base" />
    <joint name="base_link-base" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="base"/>
    </joint>

    <!-- ROS-Industrial 'flange' frame- attachment point for EEF models -->
    <link name="flange_r"/>
    <joint type="fixed" name="joint_6-flange_r">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="link_7_r"/>
      <child link="flange_r"/>
    </joint>

    <!-- ROS-Industrial 'tool0' frame- all-zeros tool frame -->
    <link name="tool0_r" />
    <joint name="link_6-tool0_r" type="fixed">
      <origin xyz="0 0 0" rpy="0 ${radians(90)} 0" />
      <parent link="flange_r" />
      <child link="tool0_r" />
    </joint>


    <!-- ROS-Industrial 'flange' frame- attachment point for EEF models -->
    <link name="flange_l"/>
    <joint type="fixed" name="joint_6-flange_l">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="link_7_l"/>
      <child link="flange_l"/>
    </joint>

    <!-- ROS-Industrial 'tool0' frame- all-zeros tool frame -->
    <link name="tool0_l" />
    <joint name="link_6-tool0_l" type="fixed">
      <origin xyz="0 0 0" rpy="0 ${radians(90)} 0" />
      <parent link="flange_l" />
      <child link="tool0_l" />
    </joint>

  </xacro:macro>
</robot>